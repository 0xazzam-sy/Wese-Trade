{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "app-ui",
  "description": "The Wese Trade UI served by the local sidecar on 127.0.0.1. Fixed named commands only: no shell, filesystem or process access.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "allow-open-data-dir",
    "allow-open-logs-dir",
    "allow-open-external-url",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-smoke-report"
  ]
}
