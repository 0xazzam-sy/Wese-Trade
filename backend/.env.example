# ---------------------------------------------------------------------------
# NeuralShot backend configuration
# Copy to `.env` (same folder) and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME=NeuralShot
# development | test | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite for local development. Relative paths are resolved against the backend/ folder.
# PostgreSQL later, e.g.: postgresql+asyncpg://user:pass@host:5432/neuralshot
DATABASE_URL=sqlite+aiosqlite:///./data/neuralshot.db

# REQUIRED. Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is rejected when APP_ENV=production.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_before_any_real_use

ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origin(s) of the frontend, comma separated (used for CORS and WebSocket origin checks).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Prepared for later phases (not required yet) --------------------------
# BingX public market data (no API keys needed for public data).
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_WS_URL=wss://open-api-swap.bingx.com/swap-market
NEWS_PROVIDER=
NEWS_API_KEY=
