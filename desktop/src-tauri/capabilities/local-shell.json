{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-shell",
  "description": "Bundled splash / startup-error / crash page (tauri://localhost). Lifecycle actions only.",
  "windows": ["main"],
  "permissions": [
    "allow-startup-status",
    "allow-app-location",
    "allow-restart-backend",
    "allow-open-logs-dir",
    "allow-restart-app",
    "allow-quit-app"
  ]
}
