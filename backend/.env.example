# ---------------------------------------------------------------------------
# Wese Trade backend configuration
# Copy to `.env` (same folder) and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

APP_NAME=Wese Trade
# development | test | production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite for local development. Relative paths are resolved against the backend/ folder.
# PostgreSQL later, e.g.: postgresql+asyncpg://user:pass@host:5432/wese_trade
DATABASE_URL=sqlite+aiosqlite:///./data/wese_trade.db

# REQUIRED. Generate a unique value with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is rejected when APP_ENV=production.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret_before_any_real_use

ACCESS_TOKEN_EXPIRE_MINUTES=720

# Browser origin(s) of the frontend, comma separated (used for CORS and WebSocket origin checks).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Market data: OKX PUBLIC endpoints (no API key, secret, passphrase or login) ---
MARKET_DATA_ENABLED=true
OKX_REST_URL=https://openapi.okx.com
# Standard TLS port 443. Do not use :8443.
OKX_PUBLIC_WS_URL=wss://ws.okx.com/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com/ws/v5/business
# A subscribed stream silent this long (while its market trades) is shown as stale.
MARKET_STALE_AFTER_SECONDS=60

# --- Prepared for later phases (not required yet) --------------------------
NEWS_PROVIDER=
NEWS_API_KEY=
