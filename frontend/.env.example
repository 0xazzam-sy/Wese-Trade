# NeuralShot frontend configuration (copy to `.env.local` to override).
# Values prefixed with VITE_ are embedded into the browser bundle — never put secrets here.

# REST API base. Relative path = same origin (Vite dev proxy / production reverse proxy).
VITE_API_BASE_URL=/api/v1

# WebSocket base. Leave empty to derive from the page origin (ws://<host>/api/v1/ws).
VITE_WS_BASE_URL=

# Dev server only: where the Vite proxy forwards /api requests.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
