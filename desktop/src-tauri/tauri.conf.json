{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wese Trade",
  "mainBinaryName": "wese-trade",
  "version": "1.0.1",
  "identifier": "com.wesetrade.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["local-shell", "app-ui"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Wese Trade",
    "category": "Finance",
    "shortDescription": "Wese Trade — crypto market analysis (analysis only, no trading)",
    "longDescription": "Arabic-first crypto market analysis workstation using OKX public market data. Analysis only: no orders, no exchange accounts.",
    "copyright": "Wese Trade",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/backend/": "backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/0xazzam-sy/Wese-Trade/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
